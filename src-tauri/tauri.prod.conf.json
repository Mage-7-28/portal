{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portal",
  "version": "0.1.0",
  "identifier": "com.cherry.portal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "Portal",
        "title": "Portal",
        "width": 1100,
        "height": 700,
        "minWidth": 820,
        "minHeight": 520,
        "resizable": true,
        "visible": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
