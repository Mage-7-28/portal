{
  "name": "portal",
  "version": "4.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "generate:styles": "node scripts/generate-antd-theme.mjs && node scripts/generate-react-hot-toast-style.mjs",
    "prebuild": "pnpm generate:styles",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dmg": "tauri build --bundles dmg --config src-tauri/tauri.prod.conf.json",
    "tauri:win32": "tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.prod.conf.json",
    "tauri:windows": "tauri build --target x86_64-pc-windows-msvc --config src-tauri/tauri.prod.conf.json",
    "tauri:linux": "tauri build --bundles deb,appimage --config src-tauri/tauri.prod.conf.json",
    "tauri:build": "tauri build --config src-tauri/tauri.prod.conf.json",
    "tauri:icon": "tauri icon public/portal-logo.svg",
    "test:unit": "vitest run",
    "lint": "eslint src scripts vite.config.js eslint.config.js --ext .js,.jsx,.mjs,.ts,.tsx",
    "lint:fix": "eslint src scripts vite.config.js eslint.config.js --ext .js,.jsx,.mjs,.ts,.tsx --fix",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "audit:dev": "pnpm audit --dev --audit-level high"
  },
  "dependencies": {
    "@rc-component/virtual-list": "1.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-global-shortcut": "~2.3.1",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "~2.4.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.3.3",
    "prismjs": "^1.30.0",
    "pubsub-js": "^1.9.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.6.0",
    "valtio": "^2.3.1"
  },
  "devDependencies": {
    "@ant-design/static-style-extract": "2.1.0",
    "@eslint/eslintrc": "3.3.7",
    "@tauri-apps/cli": "^2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "goober": "2.1.18",
    "license-checker": "^25.0.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
